{
  "kind": "collectionType",
  "collectionName": "generated_documents",
  "info": {
    "singularName": "generated-document",
    "pluralName": "generated-documents",
    "displayName": "Document généré"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "template": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::document-template.document-template"
    },
    "title": {
      "type": "text",
      "required": true
    },
    "generatedData": {
      "type": "text",
      "required": true
    },
    "pdfFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    },
    "generatedAt": {
      "type": "datetime",
      "required": true
    }
  }
}
