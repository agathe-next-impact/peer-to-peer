{
  "kind": "collectionType",
  "collectionName": "document_templates",
  "info": {
    "singularName": "document-template",
    "pluralName": "document-templates",
    "displayName": "Modèle de document"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": ["medical_report", "personal_plan", "crisis_plan", "wellness_plan", "other"]
    },
    "fields": {
      "type": "json"
    },
    "pdfTemplate": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
