{
  "kind": "collectionType",
  "collectionName": "recovery_recommendations",
  "info": {
    "singularName": "recovery-recommendation",
    "pluralName": "recovery-recommendations",
    "displayName": "Recommandation"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "type": {
      "type": "enumeration",
      "enum": ["article", "tutorial", "event", "structure", "assessment", "goal_suggestion"]
    },
    "targetContentType": {
      "type": "string"
    },
    "targetContentId": {
      "type": "integer"
    },
    "reason": {
      "type": "text"
    },
    "relevanceScore": {
      "type": "float"
    },
    "isViewed": {
      "type": "boolean",
      "default": false
    },
    "isDismissed": {
      "type": "boolean",
      "default": false
    }
  }
}
