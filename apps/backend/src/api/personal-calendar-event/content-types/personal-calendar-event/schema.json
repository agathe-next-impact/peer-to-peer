{
  "kind": "collectionType",
  "collectionName": "personal_calendar_events",
  "info": {
    "singularName": "personal-calendar-event",
    "pluralName": "personal-calendar-events",
    "displayName": "Événement calendrier personnel"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "title": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "startDate": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime"
    },
    "isAllDay": {
      "type": "boolean",
      "default": false
    },
    "eventType": {
      "type": "enumeration",
      "enum": ["appointment", "medication", "activity", "goal_milestone", "custom"]
    },
    "reminder": {
      "type": "json"
    },
    "recurrence": {
      "type": "json"
    }
  }
}
